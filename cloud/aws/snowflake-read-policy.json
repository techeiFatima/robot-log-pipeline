{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SnowflakeReadsStagedFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::<your-bucket>/staged/robot_logs/*"
    },
    {
      "Sid": "SnowflakeListsStagedFiles",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::<your-bucket>",
      "Condition": {"StringLike": {"s3:prefix": ["staged/robot_logs/*"]}}
    }
  ]
}
